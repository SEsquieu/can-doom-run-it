{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/zmusic",
        "ZDOOM_EXE_NAME": "can-doom-run-it",
        "PK3_QUIET_ZIPDIR": "ON"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux"
    },
    {
      "name": "windows",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows"
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux", "jobs": 3 },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "jobs": 3 }
  ]
}
